<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net45;net451;net452;net46;net461;net462;net47;net471;net472;net48;net481;netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<Version>3.2.3</Version>
		<Description>Asynchronous Task Extension Library</Description>
		<PackageReleaseNotes>Update target framework to .NET 11.0</PackageReleaseNotes>
		<PackageTags>API; TAP; TPL; .NET; ORM; IoC; DI; Generics; Delegates; EventHandlers; Parametric-Polymorphism</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.1.26425.128" Condition="'$(TargetFramework)' != 'net461' And '$(TargetFramework)' != 'net8.0' And '$(TargetFramework)' != 'net9.0' And ('$(IsNetCore)' != '' Or '$(IsNetStandard)' != '' Or $([System.Text.RegularExpressions.Regex]::IsMatch('$(IsNetFramework)', '^(462|47|471|472|48|481)$')))" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="6.0.0" Condition="'$(TargetFramework)' == 'net461'" />
	</ItemGroup>

</Project>
